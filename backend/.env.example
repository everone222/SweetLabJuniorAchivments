# Скопіюй цей файл у backend/.env і заповни свої значення
BOT_TOKEN="your-telegram-bot-token"
DATABASE_URL="sqlite:///./sweetlab.db"
# Локально інтерфейси віддає сам бекенд:
WEBAPP_URL="http://localhost:5000/app"
